{
  "name": "gh-block-spam-accounts",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && esbuild src/github-action/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=.github/actions/spam-blocker/index.cjs",
    "build:action": "esbuild src/github-action/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=.github/actions/spam-blocker/index.cjs",
    "format": "biome format . --write",
    "lint": "biome lint .",
    "check": "bunx --bun @biomejs/biome check --write",
    "check:action": "tsc -p tsconfig.action.json",
    "lint:eslint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/happy-work-theme": "^2.0.0",
    "@ant-design/icons": "^6.3.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@octokit/rest": "^22.0.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "antd": "^6.5.3",
    "octokit": "^5.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  }
}
